{
  "mods": [
    {
      "findTarget": [
        {
          "type": "GET",
          "path": "model"
        }
      ],
      "modify": [
        {
          "type": "ARRAY_PUSH",
          "value": {
            "key": "pluginVersion",
            "type": "REMOTE",
            "config": {
              "api": {
                "url": "/config/pluginVersion",
                "method": "GET"
              }
            }
          }
        }
      ]
    },
    {
      "findTarget": [
