      "modify": [
        {
          "type": "ARRAY_CONCAT",
          "value": [
            {
              "type": "TEXT",
              "config": {
                "componentAttrs": {
                  "class": "text-h6"
                },
                "fieldLabel": "Плагин сервера конфигурации"
              }
            },
            {
              "type": "LAYOUT_TOOLBAR",
              "config": {
                "componentAttrs": {
                  "class": "items-baseline"
