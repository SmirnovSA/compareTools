              },
              "items": [
                {
                  "type": "DISPLAY_FIELD",
                  "config": {
                    "fieldLabel": "Версия: ",
                    "text": "local:pluginVersion.version"
                  }
                }
              ]
            },
            {
              "type": "LAYOUT_TOOLBAR",
              "config": {
                "componentAttrs": {
                  "class": "items-baseline"
                }
              },
              "items": [
                {
                  "type": "DISPLAY_FIELD",
                  "config": {
                    "fieldLabel": "Хэш: ",
                    "text": "local:pluginVersion.hash"
