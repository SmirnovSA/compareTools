              ]
            },
            {
              "type": "LAYOUT_TOOLBAR",
              "config": {
                "componentAttrs": {
                  "class": "items-baseline"
                }
              },
              "items": [
                {
                  "type": "DISPLAY_FIELD",
                  "config": {
                    "fieldLabel": "Дата: ",
                    "text": "{{local:pluginVersion.date|date}}"
                  },
                  "format": [
                    {
                      "type": "DATE",
                      "key": "date",
                      "config": {
                        "date": "long",
                        "time": true,
                        "seconds": true
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "findTarget": [
        {
          "type": "FIND_BY_REF",
          "value": "gen-layout_flex_column-0-title-0-icon_button"
        },
        {
          "type": "GET",
          "path": "actions"
        },
        {
          "type": "FIND",
          "property": "type",
          "operator": "eq",
          "value": "CLIPBOARD_ADD"
        },
        {
          "type": "GET",
          "path": "config.content"
        }
      ],
      "modify": [
        {
          "type": "SET",
          "value": "Клиент\nВерсия: {{global:app.versionData.version}}\nСборка: {{global:app.versionData.build}}\nХэш: {{global:app.versionData.hash}}\nДата: {{global:app.versionData.date|date_format:long:time:seconds}}\n\nСервер конфигурации\nВерсия: {{local:serverVersion.version}}\nХэш: {{local:serverVersion.hash}}\nДата: {{local:serverVersion.date|date_format:long:time:seconds}}\n\nСервер\nВерсия: {{local:apiVersion.about.version}}\nСборка: {{local:apiVersion.about.build}}\nХэш: {{local:apiVersion.about.hash}}\nДата: {{local:apiVersion.about.date|date_format:long:time:seconds}}\n\nПлагин сервера конфигурации\nВерсия: {{local:pluginVersion.version}}\nХэш: {{local:pluginVersion.hash}}\nДата: {{local:pluginVersion.date|date_format:long:time:seconds}}"
