                          ]
                        },
                        {
                          "and": [
                            {
                              "property": "local:modelConfig.createMode",
                              "operator": "eq",
                              "value": [
                                true
                              ]
                            },
                            {
                              "property": "local:formConfig.$loading",
                              "operator": "eq",
                              "inverse": true,
                              "value": [
                                true
                              ]
                            },
                            {
                              "property": "local:formData.data.source",
                              "operator": "eq",
                              "value": ["ESBAsyncSAP"]
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
