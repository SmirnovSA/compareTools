                              "inverse": true,
                              "value": [
                                true
                              ]
                            },
                            {
                              "property": "local:formData.$loading",
                              "operator": "eq",
                              "inverse": true,
                              "value": [
                                true
                              ]
                            },
                            {
                              "property": "local:formData.data.source",
                              "operator": "eq",
                              "value": ["ESBAsyncSAP"]
