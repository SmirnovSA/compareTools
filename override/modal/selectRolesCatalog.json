        }
      ],
      "modify": [
        {
          "type": "SET",
          "value": "v3/rolecatalog/items"
        }
      ]
    },
    {
      "findTarget": [
        {
          "type": "GET",
          "path": "model"
        },
        {
          "type": "FIND",
          "property": "key",
          "operator": "eq",
          "value": "requests"
        },
        {
          "type": "GET",
          "path": "config.api.payload"
