                    "value": ["me"]
                  },
                  "config": {
                    "readyToStart": true,
                    "api": {
                      "payload": {
                        "forMe": true
                      }
                    }
                  },
                  "defaultConfig": {
                    "readyToStart": true,
                    "api": {
                      "payload": {
                        "forMe": false
                      }
                    }
                  }
                }
              }
            ]
          }
        }
