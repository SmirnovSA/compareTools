              "config": {
                "initialConfig": {
                  "title": {
                    "type": "TEMPLATE",
                    "config": {
                      "tpl": "Комментарий при рассмотрении"
                    }
                  },
                  "commentRequired": true
                },
                "url": "config/modal/comment"
              }
            },
            {
              "type": "MODIFY",
              "name": "modalSave:returnAllModal",
              "id": "filterStatusReturn",
              "config": {
                "source": "local:actionsData",
                "mods": [
                  {
                    "findTarget": [
                      {
                        "type": "GET",
                        "path": "items"
                      }
                    ],
                    "modify": [
                      {
                        "type": "SET",
                        "value": "{{local:request.items|filter|pick:ids:status:approveState}}",
                        "format": [
                          {
                            "type": "FILTER",
                            "key": "filter",
                            "config": {
                              "property": "status",
                              "operator": "in",
                              "inverse": true,
                              "value": ["COMPLETED", "COMPLETED_WITH_ERRORS", "CANCELLED", "REJECTED"]
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "MODIFY",
              "name": "modifyComplete:filterStatusReturn",
              "id": "filterStateReturn",
              "condition": {
                "property": "local:requestUsers.items.length",
                "operator": "gt",
                "value": [1]
              },
              "config": {
                "source": "local:actionsData",
                "mods": [
                  {
                    "findTarget": [
                      {
                        "type": "GET",
                        "path": "items"
                      }
                    ],
                    "modify": [
                      {
                        "type": "ARRAY_REMOVE",
                        "removeType": "objectsByPropValues",
                        "value": {
                          "approveState.forApprovingCount": 0
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "MODIFY",
              "name": "modifyComplete:filterStatusReturn",
              "id": "filterStateReturn",
              "condition": {
                "property": "local:requestUsers.items.length",
                "operator": "eq",
                "value": [1]
              },
              "config": {
                "source": "local:actionsData",
                "mods": [
                  {
                    "findTarget": [
                      {
                        "type": "GET",
                        "path": "items"
                      }
                    ],
                    "modify": [
                      {
                        "type": "SET",
                        "value": "{{local:actionsData.items|filter}}",
                        "format": [
                          {
                            "type": "FILTER",
                            "key": "filter",
                            "config": {
                              "property": "status",
                              "operator": "in",
                              "value": ["FOR_APPROVING"]
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "MODIFY",
              "name": "modifyComplete:filterStateDelegate",
              "config": {
                "source": "local:requestParams",
                "mods": [
                  {
                    "findTarget": [
                      {
                        "type": "GET",
                        "path": "actions"
                      }
                    ],
                    "modify": [
                      {
                        "type": "ARRAY_CONCAT",
                        "indexes": "{{local:actionsData.items|take|flat}}",
                        "keyWithIndex": "requestItemId",
                        "concatType": "objWithProperty",
                        "value": {
                          "decision": "replied",
                          "comment": "payload:modalSave.returnAllModal.comment"
                        },
                        "format": [
                          {
                            "type": "TAKE",
                            "key": "take",
                            "config": {
                              "fields": ["ids"]
                            }
                          },
                          {
                            "type": "FLAT",
                            "key": "flat",
                            "config": {}
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "MODIFY",
              "name": "modalSave:returnAllModal",
              "config": {
                "source": "local:decisionsMap",
                "mods": [
                  {
                    "findTarget": [
                      {
                        "type": "GET",
                        "path": "{{local:request.items|take:role:id}}",
                        "ignoreUndefined": true
                      }
                    ],
                    "modify": [
                      {
                        "type": "ARRAY_CONCAT",
                        "concatType": "concatAllRequests",
                        "target": "replied",
                        "value": "{{local:request.items|take:ids}}"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "API",
              "name": "on:checkConflicts",
              "id": "checkConflictsApi",
              "config": {
                "method": "POST",
                "payload": {
                  "actions": "raw:requestParams.actions"
                },
                "url": "v3/requests/{{route:requests}}/updateConflicts"
              }
            },
            {
              "type": "MODIFY",
              "name": "requestSuccess:checkConflictsApi",
              "config": {
                "source": "local:conflictRoles",
                "commitData": true,
                "mods": [
                  {
                    "findTarget": [
                      {
                        "type": "GET",
                        "path": "items"
                      }
                    ],
                    "modify": [
                      {
                        "type": "SET",
                        "value": "{{payload:requestSuccess.checkConflictsApi.items|remove_empty}}"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "NOTIFY",
              "name": "requestSuccess:checkConflictsApi",
              "config": {
                "message": "Конфликты обновлены"
              },
              "condition": {
                "property": "{{payload:requestSuccess.checkConflictsApi.items|remove_empty}}",
                "operator": "empty",
                "inverse": true,
                "value": []
              }
            },
            {
              "type": "NOTIFY",
              "name": "requestSuccess:checkConflictsApi",
              "config": {
                "message": "Конфликты не выявлены"
              },
              "condition": {
                "property": "{{payload:requestSuccess.checkConflictsApi.items|remove_empty}}",
                "operator": "empty",
                "value": []
              }
            }
          ]
        }
      ]
    },
    {
      "findTarget": [
        {
          "type": "FIND_BY_REF",
          "value": "all_items_action_panel_wrapper"
        },
        {
          "type": "GET",
          "path": "config.componentAttrs.style"
        }
      ],
      "modify": [
        {
          "type": "SET",
          "value": "max-width: 730px;"
        }
      ]
    },
    {
      "findTarget": [
        {
          "type": "FIND_BY_REF",
          "value": "delegateAll"
        },
        {
          "type": "GET",
          "path": "behavior.0"
        }
      ],
      "modify": [
        {
          "type": "SET",
          "value": {
            "type": "SHOW",
            "config": {
              "condition": {
                "and": [
                  {
                    "property": "local:request.metaData.total.forApprovingCount",
                    "operator": "eq",
                    "inverse": true,
                    "value": [0]
                  },
                  {
                    "property": "global:auth.currentUser.rights.all",
                    "operator": "eq",
                    "value": [true]
                  }
                ]
              }

            }
          }   
        }
      ]
    }
  ]
}
