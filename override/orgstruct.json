                ],
                "ref": "gen-layout_flex_column-4-layout_row-2-list-list_row-3-cell_link-0-layout_row"
              },
              {
                "type": "TEXT",
                "ref": "parents",
                "config": {
                  "class": "opacity-7 width-fit-content q-mt-sm",
                  "fieldLabel": "{{record:rootToTopNode|take:name|hierarchy}}",
                  "tooltip": "{{record:rootToTopNode|take:name|separate}}"
                },
                "behavior": [
                  {
                    "type": "HIDDEN",
                    "config": {
                      "condition": {
                        "property": "local:requestParams.search",
                        "operator": "eq",
                        "value": [""]
                      }
                    }
                  },
                  {
                    "type": "BINARY",
                    "config": {
                      "condition": {
                        "property": "record:type",
                        "operator": "eq",
                        "value": ["org"]
                      },
                      "config": {
                        "fieldLabel": "{{record:rootToTopNode|take:name|array_remove:last|hierarchy}}",
                        "tooltip": "{{record:rootToTopNode|take:name|array_remove:last|separate}}"
                      }
                    }
                  }
                ]
              }
            ],
            "behavior": [
              {
                "type": "BINARY",
                "config": {
                  "condition": {
                    "property": "record:type",
                    "operator": "eq",
                    "value": ["org"]
                  },
